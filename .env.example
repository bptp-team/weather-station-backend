# MQTT broker
WEATHER_MQTT_HOST=127.0.0.1
WEATHER_MQTT_PORT=1883
WEATHER_MQTT_TOPIC=weather/+/+
WEATHER_MQTT_CLIENT_ID=weather-station-backend
# Leave empty to connect anonymously, as the local development broker allows
WEATHER_MQTT_USERNAME=
WEATHER_MQTT_PASSWORD=

# InfluxDB 3
WEATHER_INFLUX_URL=http://127.0.0.1:8181
WEATHER_INFLUX_DATABASE=weather-station-db
WEATHER_INFLUX_MEASUREMENT=weather_reading
WEATHER_HISTORICAL_CACHE_PATH=
WEATHER_HISTORICAL_CACHE_RETENTION_DAYS=15

# Snapshot aggregation
WEATHER_SNAPSHOT_WINDOW_SECONDS=30

# Pluviometer calibration & drainage compensation
WEATHER_RAIN_DRAIN_RATE_ML_S=1.25
WEATHER_RAIN_FUNNEL_ML_PER_MM=4.42
WEATHER_RAIN_ADC_THRESHOLD=600
WEATHER_RAIN_ADC_SCALE=10.0

# App port exposed by the backend container
WEATHER_BACKEND_PORT=8000

# Browser clients, separated by commas with no spaces
WEATHER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
